<Window x:Class="PitzkiWidgets.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Pitzki.Controls"
        Title="Pitzki Widgets" Width="470" Height="900" ResizeMode="NoResize"
        WindowStartupLocation="Manual" AllowsTransparency="True" WindowStyle="None"
        Background="Transparent" FontFamily="Segoe UI" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- the same card, row and group shapes the Pitzki settings window is built from -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,11"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Margin" Value="62,0,16,0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="16" CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SurfaceEdgeBrush}" BorderThickness="1"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.94" ScaleY="0.94"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="7" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- everything that is only there to be looked at, clipped to the rounded corners -->
            <Border x:Name="Skin" CornerRadius="16" IsHitTestVisible="False" SizeChanged="Skin_SizeChanged">
                <Grid>
                    <!-- a paper grain over the whole surface, speckled in code -->
                    <Rectangle x:Name="Grain" Opacity="0.55"/>

                    <!-- a wash of the accent colour behind Pitzki, like a lamp in the corner -->
                    <Ellipse Width="520" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-150,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#33AFA9EC"/>
                                <GradientStop Offset="0.55" Color="#12AFA9EC"/>
                                <GradientStop Offset="1" Color="#00AFA9EC"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- the lit top edge -->
                    <Border Height="1.4" VerticalAlignment="Top" Margin="30,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#00FFFFFF"/>
                                <GradientStop Offset="0.5" Color="#B0FFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- a light that sweeps across once as the window opens -->
                    <Border x:Name="Sheen" Width="150" HorizontalAlignment="Left" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#00FFFFFF"/>
                                <GradientStop Offset="0.45" Color="#26FFFFFF"/>
                                <GradientStop Offset="0.55" Color="#26FFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <SkewTransform AngleX="-16"/>
                                <TranslateTransform x:Name="SheenSlide" X="-320"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <DockPanel>
                <!-- Pitzki himself sits at the top, the way he does in the settings sidebar -->
                <Grid DockPanel.Dock="Top" Margin="22,18,12,14" Background="Transparent" MouseLeftButtonDown="Drag">
                    <StackPanel Orientation="Horizontal">
                        <c:Mascot x:Name="Pit" Width="52" Height="42" Accent="{DynamicResource AccentBrush}"
                                  Texture="Stars" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Widgets" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Count" Text="What should sit on your desktop" FontSize="11.5"
                                       Foreground="{StaticResource SubtleBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Click="Close_Click" ToolTip="Close"/>
                </Grid>

                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="22,0,16,16">

                        <StackPanel x:Name="Lists"/>

                        <!-- only in the way while the weather card is out -->
                        <StackPanel x:Name="CityBox" Visibility="Collapsed">
                            <TextBlock Text="Weather" Style="{StaticResource Group}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Style="{StaticResource Row}" Margin="16,12">
                                    <StackPanel Margin="0,0,164,0" VerticalAlignment="Center">
                                        <TextBlock Text="City" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="Where the weather comes from" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <TextBox x:Name="City" Style="{StaticResource DarkTextBox}" Width="150"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                    <!-- or let Pitzki work it out from the connection -->
                                    <StackPanel x:Name="LocateRow" Orientation="Horizontal" Margin="16,0,16,12"/>
                                    <TextBlock Text="Guesses your city from your internet connection, using GeoJS. It only happens when you press the button."
                                               Style="{StaticResource RowHint}" Margin="16,0,16,12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Startup" Style="{StaticResource Group}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid Style="{StaticResource Row}" Margin="16,12">
                                <StackPanel Margin="0,0,60,0" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="The cards come back by themselves after a restart" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox x:Name="Startup" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid Style="{StaticResource Row}" Margin="16,12">
                                <StackPanel Margin="0,0,60,0" VerticalAlignment="Center">
                                    <TextBlock Text="Show in the Start menu" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="A shortcut in your own Start menu, so typing its name finds it" Style="{StaticResource RowHint}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="InStart" Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid Style="{StaticResource Row}" Margin="16,12">
                                <StackPanel Margin="0,0,150,0" VerticalAlignment="Center">
                                    <TextBlock Text="Backup of your cards" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="BackupHint" Text="Every card, where it sits, and what is written on it, in one file" Style="{StaticResource RowHint}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel x:Name="BackupKeys" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
