<Window x:Class="PitzkiWidgets.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pitzki widget" ShowInTaskbar="False" AllowsTransparency="True" WindowStyle="None"
        Background="Transparent" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="False"
        Opacity="0">
    <!-- the size is a layout transform, so the window grows with the card instead of cutting it off -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Zoom"/>
        </Grid.LayoutTransform>
        <!-- a soft shadow under the card, drawn rather than blurred so it costs nothing -->
        <Border x:Name="Shade" Margin="6,7,6,5" CornerRadius="18" Background="#30000000"/>
        <Border x:Name="Card" Margin="4" CornerRadius="16" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource SurfaceEdgeBrush}" BorderThickness="1">
            <!-- everything inside is cut to the card's own rounded shape: ClipToBounds would cut to a square -->
            <Grid x:Name="Inside" SizeChanged="Inside_SizeChanged">
                <!-- the same paper grain the Widgets window has, so nothing is a flat slab of colour -->
                <Border x:Name="Grain" CornerRadius="16" Opacity="0.5" IsHitTestVisible="False"/>
                <!-- the lit top edge, which is what makes it look raised -->
                <Border Height="1.2" VerticalAlignment="Top" Margin="18,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#00FFFFFF"/>
                            <GradientStop Offset="0.5" Color="#80FFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- liquid glass: a lit body, light along the top edge, a glow under the pointer and a sheen drifting across -->
                <Grid x:Name="Glass" Opacity="0" IsHitTestVisible="False">
                    <Border CornerRadius="15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#18FFFFFF"/>
                                <GradientStop Offset="0.18" Color="#0EFFFFFF"/>
                                <GradientStop Offset="0.7" Color="#00FFFFFF"/>
                                <GradientStop Offset="1" Color="#0EFFFFFF"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- the far corner catches a second, fainter light, the way a thick pane does -->
                    <Border CornerRadius="15">
                        <Border.Background>
                            <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.55" RadiusY="0.7">
                                <GradientStop Offset="0" Color="#0AFFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border x:Name="GlassLip" Height="2" VerticalAlignment="Top" Margin="14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#00FFFFFF"/>
                                <GradientStop Offset="0.5" Color="#55FFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas>
                    <Ellipse x:Name="GlassTouch" Width="200" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#10FFFFFF"/>
                                <GradientStop Offset="0.55" Color="#0AFFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="GlassTouchT"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border x:Name="GlassSheen" Width="90" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#00FFFFFF"/>
                                <GradientStop Offset="0.45" Color="#0CFFFFFF"/>
                                <GradientStop Offset="0.55" Color="#0CFFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TransformGroup>
                                <SkewTransform AngleX="-18"/>
                                <TranslateTransform x:Name="GlassSheenT" X="-200"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                    </Canvas>
                </Grid>
                <!-- a brighter rim while the pointer is on the card -->
                <Border x:Name="Lift" CornerRadius="16" BorderThickness="1" BorderBrush="#35FFFFFF"
                        Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter x:Name="Body" Margin="14,12,14,12"/>
                <!-- the handle only shows when the pointer is over the card -->
                <Border x:Name="Grip" Height="18" VerticalAlignment="Top" Background="Transparent" Opacity="0">
                    <Border Width="26" Height="3.5" CornerRadius="2" Background="#44FFFFFF" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
